# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
# If configured here, all team members accessing the web application can use this shared key.
# Alternatively, team members can enter their key directly in the web UI.
GEMINI_API_KEY=your_gemini_api_key_here

# Server host and port (0.0.0.0 allows teammates on the same local network / Wi-Fi to connect)
HOST=0.0.0.0
PORT=8000
